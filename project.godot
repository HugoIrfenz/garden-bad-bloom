config_version=5
[application]
config/name="Garden: Bad Bloom"
config/icon="res://assets/art/garden_app_icon.png"
run/main_scene="res://studio_splash.tscn"
[display]
window/size/viewport_width=864
window/size/viewport_height=390
window/stretch/mode="viewport"
window/handheld/orientation=0
[input_devices]
pointing/emulate_mouse_from_touch=false
[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08, 0.07, 0.13, 1)
