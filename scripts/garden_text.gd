static func supports(language: String) -> bool:
	return language in [ENGLISH, INDONESIAN]

static func device_language(locale: String) -> String:
	var code := locale.to_lower().replace("-", "_").get_slice(".", 0).get_slice("_", 0)
	return INDONESIAN if code in [INDONESIAN, "in"] else ENGLISH

static func message(language: String, key: String, fields: Dictionary = {}, fallback := "") -> String:
	var pair: Array = MESSAGES.get(key, [])
	if pair.is_empty():
		return fallback if not fallback.is_empty() else key
	var english: String = pair[0]
	var localized: String = pair[1] if language == INDONESIAN and pair.size() > 1 else english
	var result := english if localized.is_empty() else localized
	return result if fields.is_empty() else result.format(fields)

static func place_name(language: String, original: String) -> String:
	return PLACE_NAMES_ID.get(original, original) if language == INDONESIAN else original
